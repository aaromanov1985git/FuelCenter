# Фронтенд (Vite + React) — PRODUCTION: сборка в статику + nginx
# Используется через docker-compose.prod.yml. В отличие от Dockerfile.frontend
# (dev, Vite hot-reload) здесь нет монтирования исходников и watch-режима.

# ── Этап сборки ────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# Базовый путь приложения (/ для корня; /app/ для подпути)
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
RUN npm run build

# ── Этап раздачи ───────────────────────────────────────────────
FROM nginx:1.27-alpine
# Конфиг: SPA + проксирование /api на backend в docker-сети
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
