# ═══════════════════════════════════════════════════════════════
#  GSM Converter — шаблон .env для НОВОГО сервера (Ubuntu + Docker)
# ═══════════════════════════════════════════════════════════════
#
#  Положить как:  <project>/.env   (рядом с docker-compose.yml)
#  Docker Compose подхватит эти значения автоматически.
#
#  ⚠️  НУЖНЫ ДВА ФАЙЛА. Этот — корневой .env, из него Compose подставляет
#      ${...} в compose-файлы (порты, CORS, DATABASE_URL).
#      Приложение же читает критичные настройки из backend/.env — он подключён
#      к сервису backend через env_file, и в блоке environment: их намеренно нет.
#      Без backend/.env `docker compose up` падает сразу (env_file обязателен),
#      а при расхождении SECRET_KEY приложение возьмёт значение из backend/.env.
#      Минимальный backend/.env (значения — из out/backend.env.backup):
#          ENABLE_AUTH=true
#          SECRET_KEY=<ТОТ ЖЕ, ЧТО НИЖЕ>
#          JWT_EXPIRE_MINUTES=30
#          ADMIN_USERNAME=admin
#          ADMIN_PASSWORD=<...>
#          ADMIN_EMAIL=<...>
#          ENVIRONMENT=production
#          COOKIE_SECURE=false
#      Оба файла проверяет 00_preflight_check.sh.
#
#  ⚠️  ЭТО ШАБЛОН. Все значения <В_УГЛОВЫХ_СКОБКАХ> обязательны к замене.
#      Реальные секреты в репозиторий НЕ коммитить.
#
#  Проверить заполненный .env перед запуском:
#      bash migration_backup/linux/00_preflight_check.sh
# ───────────────────────────────────────────────────────────────

# ── Адрес нового сервера ───────────────────────────────────────
# IP или DNS-имя, по которому пользователи открывают приложение.
# Используется для сборки ALLOWED_ORIGINS, GRAFANA_ROOT_URL и сообщений скриптов.
# Пример: GSM_HOST=10.35.1.60   или   GSM_HOST=gsm.starwayp.local
GSM_HOST=<IP_ИЛИ_DNS_НОВОГО_СЕРВЕРА>

# Схема доступа: http (по умолчанию) или https (если TLS терминируется впереди).
GSM_SCHEME=http

# ── Аутентификация / безопасность ──────────────────────────────
ENABLE_AUTH=true
ENVIRONMENT=production

# ⚠️  КРИТИЧНО: SECRET_KEY ДОЛЖЕН совпадать со старым сервером.
#     Им шифруются connection_settings провайдеров (ГПН/РН-Карт/ППР/Firebird).
#     Другой ключ = сохранённые пароли провайдеров не расшифруются
#     и все выданные JWT станут невалидными.
#     Значение брать из migration_backup/linux/out/backend.env.backup
#     (создаётся скриптом 01_backup_current_server.sh).
SECRET_KEY=<СКОПИРОВАТЬ_ИЗ_backend.env.backup>

# ENCRYPTION_KEY на старом сервере НЕ задавался — шифрование использует SECRET_KEY.
# ОСТАВИТЬ ЗАКОММЕНТИРОВАННЫМ, иначе старые зашифрованные данные не прочитаются.
# ENCRYPTION_KEY=

JWT_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<СКОПИРОВАТЬ_ИЗ_backend.env.backup>
ADMIN_EMAIL=<EMAIL_АДМИНИСТРАТОРА>

# ⚠️  КРИТИЧНО при доступе по HTTP (GSM_SCHEME=http).
#     При COOKIE_SECURE=true браузер НЕ отправит auth-cookie по HTTP → вход не работает.
#     Вернуть true ТОЛЬКО после настройки HTTPS (и тогда GSM_SCHEME=https).
COOKIE_SECURE=false

# ── CORS: разрешённые источники ────────────────────────────────
# В prod-стеке (docker-compose.prod.yml) фронт и /api живут на одном origin
# за nginx → CORS практически не задействуется, но список оставляем корректным.
# Подставьте сюда свой GSM_HOST (переменные внутри .env не раскрываются!).
ALLOWED_ORIGINS=http://<IP_ИЛИ_DNS_НОВОГО_СЕРВЕРА>:3002,http://<IP_ИЛИ_DNS_НОВОГО_СЕРВЕРА>:8000,http://<IP_ИЛИ_DNS_НОВОГО_СЕРВЕРА>,http://localhost:3002

# Дополнительные хосты для Vite dev-сервера (только docker-compose.yml, dev-режим).
# IP-литералы Vite пропускает без настройки; DNS-имя нужно перечислить здесь.
# VITE_ALLOWED_HOSTS=gsm.starwayp.local,.starwayp.local

# ── База данных ────────────────────────────────────────────────
POSTGRES_USER=gsm_user
POSTGRES_PASSWORD=<ЗАДАТЬ_ПАРОЛЬ_POSTGRES>
POSTGRES_DB=gsm_db
POSTGRES_PORT=5432
# Должен совпадать с POSTGRES_USER/PASSWORD/DB выше. Хост 'db' — имя сервиса в docker-сети.
DATABASE_URL=postgresql://gsm_user:<ЗАДАТЬ_ПАРОЛЬ_POSTGRES>@db:5432/gsm_db

# ── Порты проброса на хост ─────────────────────────────────────
BACKEND_PORT=8000
# В prod можно FRONTEND_PORT=80 → чистый URL без порта.
FRONTEND_PORT=3002
REDIS_PORT=6379

# ── Загрузка / Rate limiting ───────────────────────────────────
MAX_UPLOAD_SIZE=52428800
ENABLE_RATE_LIMIT=true
RATE_LIMIT_DEFAULT=500/minute
RATE_LIMIT_STRICT=50/minute

# ── Мониторинг (если поднимаете docker-compose.monitoring.yml) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<ЗАДАТЬ_ПАРОЛЬ_GRAFANA>
GRAFANA_ROOT_URL=http://<IP_ИЛИ_DNS_НОВОГО_СЕРВЕРА>:3001
