# ═══════════════════════════════════════════════════════════════
#  GSM Converter — .env для НОВОГО сервера 10.35.1.55 (Linux + Docker)
# ═══════════════════════════════════════════════════════════════
#
#  Положить как:  <project>/.env   (рядом с docker-compose.yml)
#  Docker Compose подхватит эти значения автоматически.
#
#  ⚠️  SECRET_KEY ДОЛЖЕН совпадать со старым сервером, иначе расшифровка
#      сохранённых паролей провайдеров/Firebird и старые JWT сломаются.
#      Значение — из migration_backup/backend.env.backup.
# ───────────────────────────────────────────────────────────────

# ── Аутентификация / безопасность ──────────────────────────────
ENABLE_AUTH=true
ENVIRONMENT=production

# Берётся ИЗ migration_backup/backend.env.backup (НЕ менять при переносе!)
SECRET_KEY=2Pk517dRhloeX0sCGF4d3r6ERjQZ6C_RzlMT7anX_MgvQolF69dwX1sBzVRjjKkwVMKteVknP3JnSMMxfx212Q

# ENCRYPTION_KEY на старом сервере НЕ задавался — шифрование использует SECRET_KEY.
# Оставить пустым/закомментированным, иначе старые зашифрованные данные не прочитаются.
# ENCRYPTION_KEY=

JWT_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TljzCMBVJjeD8SiZ
ADMIN_EMAIL=aaromanov@starwayp.com

# ⚠️  КРИТИЧНО: доступ по http://10.35.1.55 (без HTTPS).
#     При COOKIE_SECURE=true браузер НЕ отправит auth-cookie по HTTP → вход не работает.
#     Для HTTP-доступа по IP обязательно false. Вернуть true только после настройки HTTPS.
COOKIE_SECURE=false

# ── CORS: разрешённые источники нового сервера ─────────────────
ALLOWED_ORIGINS=http://10.35.1.55:3002,http://10.35.1.55:8000,http://10.35.1.55,http://localhost:3002

# ── База данных ────────────────────────────────────────────────
POSTGRES_USER=gsm_user
POSTGRES_PASSWORD=gsm_password
POSTGRES_DB=gsm_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gsm_user:gsm_password@db:5432/gsm_db

# ── Порты проброса на хост ─────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3002
REDIS_PORT=6379

# ── Загрузка / Rate limiting ───────────────────────────────────
MAX_UPLOAD_SIZE=52428800
ENABLE_RATE_LIMIT=true
RATE_LIMIT_DEFAULT=500/minute
RATE_LIMIT_STRICT=50/minute

# ── Мониторинг (если поднимаете docker-compose.monitoring.yml) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_ROOT_URL=http://10.35.1.55:3001
